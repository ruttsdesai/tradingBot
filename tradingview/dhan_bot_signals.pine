// =============================================================================
//  Dhan Bot Signals — TradingView mirror of the Python intraday bot
// =============================================================================
//  Reproduces the live bot's decision logic so you can see the same BUY/SELL
//  calls on a chart and trade them manually.
//
//  Parameters below match config.yaml exactly (NOT the library defaults):
//      RSI_MeanReversion : RSI(14), buy < 30, sell > 70
//      BollingerBands    : SMA(10) +/- 1.5 std        <- config, not 20/2.0
//      MA_Crossover      : SMA(20) vs SMA(50), on the CROSS only
//
//  Consensus rule (same as the bot): count BUY votes vs SELL votes across the
//  three strategies. Act only when one side outnumbers the other. A tie, or
//  all-HOLD, does nothing. HOLD abstains — it does not block.
//
//  Intraday guards (same as the bot, IST):
//      - no new BUYs after 15:00
//      - flat by 15:10 (square-off)
//      - skip BUYs when ATR/close < 0.15% (dead market)
//      - 15-minute re-entry cooldown after an exit
//
//  HONEST NOTE: this mirrors the bot, and the bot has NOT been shown to be
//  profitable — over the paper test to date the account is slightly down, and
//  backtests put it below buy-and-hold. Treat these as a structured second
//  opinion for discretionary trading, not as recommendations to follow blindly.
//
//  Setup: TradingView -> Pine Editor -> paste -> Add to chart. Use a 5-minute
//  chart on an NSE symbol to match the bot.
// =============================================================================

//@version=6
indicator("Dhan Bot Signals", overlay = true, max_labels_count = 500)

// ---------------------------------------------------------------- inputs ----
grpS = "Strategy parameters (match config.yaml)"
rsiLen  = input.int(14,    "RSI length",             group = grpS, minval = 2)
rsiBuy  = input.float(30,  "RSI oversold (buy)",     group = grpS)
rsiSell = input.float(70,  "RSI overbought (sell)",  group = grpS)
bbLen   = input.int(10,    "Bollinger length",       group = grpS, minval = 2)
bbStd   = input.float(1.5, "Bollinger std dev",      group = grpS, step = 0.1)
maFast  = input.int(20,    "MA fast",                group = grpS, minval = 1)
maSlow  = input.int(50,    "MA slow",                group = grpS, minval = 2)

grpR = "Intraday rules"
useSession   = input.bool(true, "Apply intraday time rules (IST)", group = grpR)
stopBuyHour  = input.int(15,    "Stop new BUYs at hour", group = grpR, minval = 0, maxval = 23)
stopBuyMin   = input.int(0,     "...and minute",         group = grpR, minval = 0, maxval = 59)
sqOffHour    = input.int(15,    "Square-off hour",       group = grpR, minval = 0, maxval = 23)
sqOffMin     = input.int(10,    "...and minute",         group = grpR, minval = 0, maxval = 59)
useVolFilter = input.bool(true, "Volatility filter",     group = grpR)
minVolPct    = input.float(0.15,"Min ATR/close %",       group = grpR, step = 0.01)
atrLen       = input.int(14,    "ATR length",            group = grpR, minval = 1)
cooldownMin  = input.int(15,    "Re-entry cooldown (min)", group = grpR, minval = 0)

grpV = "Display"
showBands = input.bool(true,  "Show Bollinger bands",       group = grpV)
showMAs   = input.bool(true,  "Show moving averages",       group = grpV)
showVotes = input.bool(true,  "Show vote table",            group = grpV)
showBg    = input.bool(false, "Shade consensus background", group = grpV)

// ------------------------------------------------------------- functions ----
// NOTE: Pine requires function declarations at GLOBAL scope — they cannot live
// inside an `if` block. That mistake is what produced the earlier syntax error.
sigText(bool b, bool s) =>
    b ? "BUY" : s ? "SELL" : "HOLD"

sigColor(bool b, bool s) =>
    b ? color.green : s ? color.red : color.gray

// ------------------------------------------------------------ indicators ----
rsi    = ta.rsi(close, rsiLen)
basis  = ta.sma(close, bbLen)
dev    = bbStd * ta.stdev(close, bbLen)
upper  = basis + dev
lower  = basis - dev
maF    = ta.sma(close, maFast)
maS    = ta.sma(close, maSlow)
atr    = ta.atr(atrLen)
volPct = close > 0 ? atr / close * 100.0 : 0.0

// ------------------------------------------------------- strategy signals ----
// RSI mean reversion — threshold levels (Python: rsi < 30 / rsi > 70)
rsiBuySig  = rsi < rsiBuy
rsiSellSig = rsi > rsiSell

// Bollinger — price at/through a band (Python: close <= lower / >= upper)
bbBuySig  = close <= lower
bbSellSig = close >= upper

// MA crossover — the Python version fires ONLY on the cross bar, not while
// fast merely sits above slow. ta.crossover/crossunder reproduces that.
maBuySig  = ta.crossover(maF, maS)
maSellSig = ta.crossunder(maF, maS)

// ------------------------------------------------------------- consensus ----
buyVotes  = (rsiBuySig ? 1 : 0)  + (bbBuySig ? 1 : 0)  + (maBuySig ? 1 : 0)
sellVotes = (rsiSellSig ? 1 : 0) + (bbSellSig ? 1 : 0) + (maSellSig ? 1 : 0)

consensusBuy  = buyVotes > sellVotes
consensusSell = sellVotes > buyVotes

// ---------------------------------------------------------- intraday gate ----
// Chart time is exchange time; for NSE symbols that is already IST.
nowMins   = hour * 60 + minute
stopBuyAt = stopBuyHour * 60 + stopBuyMin
sqOffAt   = sqOffHour * 60 + sqOffMin

pastStopBuy = useSession and nowMins >= stopBuyAt
atSquareOff = useSession and nowMins >= sqOffAt
lowVol      = useVolFilter and volPct < minVolPct

// Track a notional position so cooldown + square-off behave honestly.
var bool inPos       = false
var int  lastExitBar = na

barsPerMin   = math.max(timeframe.in_seconds() / 60.0, 1.0)
barsCooldown = cooldownMin / barsPerMin
inCooldown   = not na(lastExitBar) and (bar_index - lastExitBar) < barsCooldown

// A BUY is actionable only if every gate the bot applies also passes.
buySignal  = consensusBuy and not inPos and not pastStopBuy and not lowVol and not inCooldown
sellSignal = inPos and (consensusSell or atSquareOff)

// Remember the most recent actionable signal, so the panel can show what the
// last call was and how stale it is — a signal only PRINTS on its own bar, but
// you usually want to know "what was the last thing this told me, and when".
var string lastSig    = "none"
var int    lastSigBar = na

if buySignal
    inPos := true
    lastSig := "BUY"
    lastSigBar := bar_index
if sellSignal
    inPos := false
    lastExitBar := bar_index
    lastSig := "SELL"
    lastSigBar := bar_index

// ------------------------------------------------------------------ plots ----
plot(showMAs ? maF : na, "MA fast", color = color.new(color.aqua, 0),   linewidth = 1)
plot(showMAs ? maS : na, "MA slow", color = color.new(color.orange, 0), linewidth = 1)
pu = plot(showBands ? upper : na, "BB upper", color = color.new(color.gray, 50))
pl = plot(showBands ? lower : na, "BB lower", color = color.new(color.gray, 50))
fill(pu, pl, color = color.new(color.gray, 92))

plotshape(buySignal, title = "BUY", style = shape.labelup, location = location.belowbar,
     color = color.new(color.green, 0), textcolor = color.white, text = "BUY", size = size.small)
plotshape(sellSignal, title = "SELL", style = shape.labeldown, location = location.abovebar,
     color = color.new(color.red, 0), textcolor = color.white, text = "SELL", size = size.small)

// Signals the bot would SKIP — shows why nothing fired.
blocked = consensusBuy and not inPos and (pastStopBuy or lowVol or inCooldown)
plotshape(blocked, title = "BUY blocked", style = shape.xcross, location = location.belowbar,
     color = color.new(color.gray, 30), size = size.tiny)

bgcolor(showBg and consensusBuy  ? color.new(color.green, 90) : na)
bgcolor(showBg and consensusSell ? color.new(color.red,   90) : na)

// ------------------------------------------------------- LIVE ACTION PANEL ----
// Anchored to the top-right of the viewport, so it stays put while you scroll
// and always reports the LATEST bar — that is the live reading. On a closed
// market (nights, weekends) the last candle is frozen, so nothing will change
// until the session reopens.
var table panel = table.new(position.top_right, 2, 10, border_width = 1,
     frame_color = color.gray, frame_width = 1)

// What should I do RIGHT NOW?
actionTxt = buySignal          ? "BUY NOW"
     : sellSignal              ? "SELL NOW"
     : inPos                   ? "HOLDING"
     : blocked                 ? "BUY BLOCKED"
     : consensusSell           ? "SELL signal (no position)"
     :                           "WAIT"

actionCol = buySignal ? color.green : sellSignal ? color.red
     : inPos ? color.teal : blocked ? color.orange : color.gray

barsAgo  = na(lastSigBar) ? na : bar_index - lastSigBar
lastTxt  = lastSig == "none" ? "none yet"
     : lastSig + " " + (barsAgo == 0 ? "this bar" : str.tostring(barsAgo) + " bars ago")

if showVotes and barstate.islast
    // headline action — deliberately the biggest thing on the panel
    table.cell(panel, 0, 0, "ACTION", text_color = color.white, bgcolor = actionCol,
         text_size = size.normal, text_halign = text.align_left)
    table.cell(panel, 1, 0, actionTxt, text_color = color.white, bgcolor = actionCol,
         text_size = size.normal, text_halign = text.align_right)

    table.cell(panel, 0, 1, "RSI " + str.tostring(rsi, "#.0"), text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 1, sigText(rsiBuySig, rsiSellSig), text_color = sigColor(rsiBuySig, rsiSellSig), text_size = size.small, text_halign = text.align_right)

    table.cell(panel, 0, 2, "Bollinger", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 2, sigText(bbBuySig, bbSellSig), text_color = sigColor(bbBuySig, bbSellSig), text_size = size.small, text_halign = text.align_right)

    table.cell(panel, 0, 3, "MA cross", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 3, sigText(maBuySig, maSellSig), text_color = sigColor(maBuySig, maSellSig), text_size = size.small, text_halign = text.align_right)

    consTxt = consensusBuy ? "BUY " + str.tostring(buyVotes) + "/3" : consensusSell ? "SELL " + str.tostring(sellVotes) + "/3" : "no majority"
    table.cell(panel, 0, 4, "Consensus", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 4, consTxt, text_color = sigColor(consensusBuy, consensusSell), text_size = size.small, text_halign = text.align_right)

    table.cell(panel, 0, 5, "Last signal", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 5, lastTxt, text_color = lastSig == "BUY" ? color.green : lastSig == "SELL" ? color.red : color.gray, text_size = size.small, text_halign = text.align_right)

    table.cell(panel, 0, 6, "Position", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 6, inPos ? "LONG" : "flat", text_color = inPos ? color.green : color.gray, text_size = size.small, text_halign = text.align_right)

    table.cell(panel, 0, 7, "ATR/close", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 7, str.tostring(volPct, "#.00") + "%", text_color = lowVol ? color.red : color.green, text_size = size.small, text_halign = text.align_right)

    gateTxt = pastStopBuy ? "past 15:00" : inCooldown ? "cooldown" : lowVol ? "low vol" : "open"
    gateCol = (pastStopBuy or inCooldown or lowVol) ? color.orange : color.green
    table.cell(panel, 0, 8, "Gate", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 8, gateTxt, text_color = gateCol, text_size = size.small, text_halign = text.align_right)

    // Last bar's timestamp makes it obvious when the market is closed and the
    // panel is simply showing a frozen candle rather than malfunctioning.
    table.cell(panel, 0, 9, "Bar time", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 9, str.format_time(time, "dd MMM HH:mm", syminfo.timezone), text_color = color.gray, text_size = size.small, text_halign = text.align_right)

// ----------------------------------------------------------------- alerts ----
alertcondition(buySignal,  "Bot BUY",  "Dhan bot consensus BUY on {{ticker}} at {{close}}")
alertcondition(sellSignal, "Bot SELL", "Dhan bot consensus SELL on {{ticker}} at {{close}}")
